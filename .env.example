# Copy to .env and fill in your own values. Never commit .env.
#
# Session cookie for an X/Twitter account you own, used only to satisfy the
# login wall on twitter.com/search. Obtain it from your own logged-in browser
# session (DevTools > Application > Cookies > auth_token). Do NOT put a
# plaintext password anywhere in this project.
TWITTER_AUTH_TOKEN=

# CSRF token cookie, required alongside auth_token for a fully authenticated
# session (X rejects auth_token alone on some endpoints). Same DevTools path:
# Application > Cookies > ct0.
TWITTER_CT0=

# Comma-separated Nitter mirror instances used as a fallback when twitter.com
# blocks the scraper. Update this list periodically -- public instances churn.
NITTER_INSTANCES=https://nitter.net,https://nitter.privacydev.net

HASHTAGS=nifty50,sensex,intraday,banknifty
TARGET_TWEET_COUNT=2000
HEADLESS=true
LOG_LEVEL=INFO
